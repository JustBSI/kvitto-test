# Placeholders only. scripts/setup_env.py creates a local .env with random secrets.
# These hosts are Compose service names; use localhost for local Python commands.
POSTGRES_USER=<local-user>
POSTGRES_PASSWORD=<generate-a-local-password>
POSTGRES_DB=<local-database>
DATABASE_URL=postgresql+asyncpg://<user>:<password>@db:5432/<database>
TEST_DATABASE_URL=postgresql+asyncpg://<user>:<password>@test-db:5432/<database>_test
WEBHOOK_SECRET=<generate-a-local-secret>
